# Copy this file to .env and fill in your key. Never commit .env.
# No quotes around values (Docker reads this file literally).

# --- Option A: OpenRouter ---
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_AUTH_TOKEN=sk-or-your-openrouter-key
AGENT_MODEL=mistralai/mistral-small-3.2-24b-instruct

# --- Option B: Anthropic directly (comment out Option A first) ---
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# AGENT_MODEL=claude-opus-5-5

# --- Approval ---
# manual: you approve every call (default). auto: a classifier approves calls
# that match your request and asks you when unsure.
APPROVAL_MODE=manual
# Optional: a different model for the classifier (defaults to AGENT_MODEL).
# CLASSIFIER_MODEL=
